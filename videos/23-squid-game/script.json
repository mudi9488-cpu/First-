     "show": "Every time I lost,"
    },
    {
     "show": "he slapped me."
    },
    {
     "show": "Every time I won,"
    },
    {
     "show": "he paid me."
    },
    {
     "show": "Then he asked:"
    },
    {
     "show": "Want to make some {g:real money?}"
    },
    {
     "show": "And he gave me a card."
    },
    {
     "show": "{y:Circle. Triangle. Square.}"
    }
   ]
  },
  {
   "id": "island",
   "label": "",
   "lines": [
