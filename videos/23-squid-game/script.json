 "beats": [
  {
   "id": "hook",
   "label": "",
   "lines": [
    {
     "show": "In this game,"
    },
    {
     "show": "456 people play {y:children's games.}"
    },
    {
     "show": "The winner gets"
    },
    {
     "show": "{g:45.6 billion won.}"
    },
    {
     "show": "But if you lose,"
    },
    {
     "show": "you're out."
    },
    {
     "show": "{r:Forever.}"
    }
   ]
  },
  {
   "id": "me",
   "label": "",
   "lines": [
    {
     "show": "My name is Gi-hun."
    },
    {
     "show": "Player {y:456.}"
    },
    {
     "show": "I was broke,"
    },
    {
     "show": "divorced,"
    },
    {
     "show": "and I owed money"
    },
    {
     "show": "to very bad people."
    }
   ]
  },
  {
   "id": "subway",
   "label": "",
   "lines": [
