    {
     "show": "and my childhood friend,"
    },
    {
     "show": "Sang-woo."
    },
    {
     "show": "In the rain."
    },
    {
     "show": "On a giant squid drawn in the sand."
    },
    {
     "show": "I asked him to stop."
    },
    {
     "show": "To go home together."
    },
    {
     "show": "He didn't."
    }
   ]
