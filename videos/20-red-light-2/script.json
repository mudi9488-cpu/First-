    },
    {
     "show": "Inside was a giant machine."
    },
    {
     "show": "Thousands of buttons."
    },
    {
     "show": "And every button"
    },
    {
     "show": "had a {y:name} on it."
    }
   ]
  },
  {
   "id": "names",
   "label": "",
   "lines": [
    {
     "show": "My teacher."
    },
    {
     "show": "The baker."
    },
    {
     "show": "My {r:mom.}"
    },
    {
     "show": "Everyone's button was {r:red.}"
    },
    {
     "show": "Then I found one"
    },
    {
     "show": "that said {y:Mayor.}"
