{
 "title": "The Red Light – Part 2",
 "voice": "ElevenLabs: In This town",
 "beats": [
  {
   "id": "recap",
   "label": "",
   "lines": [
    {
     "show": "In this town,"
    },
    {
     "show": "every time you lie,"
    },
    {
     "show": "a {r:red light} turns on above your head."
    },
    {
     "show": "Last Monday,"
    },
    {
     "show": "everyone's light turned on."
    },
    {
     "show": "{g:Except mine.}"
    },
    {
     "show": "And the mayor's."
    }
   ]
  },
  {
   "id": "door",
   "label": "",
   "lines": [
    {
     "show": "Now the mayor was standing"
    },
    {
     "show": "at our front door."
    },
    {
     "show": "{r:Smiling.}"
    }
   ]
  },
  {
   "id": "talk",
   "label": "",
   "lines": [
    {
     "show": "Noah, he said,"
    },
    {
     "show": "the town needs its most honest kid."
    },
    {
     "show": "Come with me to the TV studio."
    },
    {
     "show": "Tell everyone the lights are {y:real.}"
    },
    {
     "show": "They will believe {y:you.}"
    }
   ]
  },
  {
   "id": "mom",
   "label": "",
   "lines": [
    {
     "show": "My mom grabbed my arm."
    },
    {
     "show": "Her light was {r:blinking.}"
    },
    {
     "show": "But she didn't say a word."
    }
   ]
  },
  {
   "id": "car",
   "label": "",
   "lines": [
    {
     "show": "So I got in the black car."
    },
    {
     "show": "The whole town was watching"
    },
    {
     "show": "from behind their curtains."
    },
    {
     "show": "Hundreds of {r:red lights}"
    },
    {
     "show": "in the dark windows."
    }
   ]
  },
  {
   "id": "studio",
   "label": "",
   "lines": [
    {
     "show": "The studio was huge."
    },
    {
     "show": "Cameras everywhere."
    },
    {
     "show": "A giant sign said {r:LIVE.}"
    },
    {
     "show": "The mayor gave me a card."
    },
    {
     "show": "It said:"
    },
    {
     "show": "{y:The lights never lie.}"
    }
   ]
  },
  {
   "id": "wait",
   "label": "",
   "lines": [
    {
     "show": "Then he whispered:"
    },
    {
     "show": "Just read this,"
    },
    {
     "show": "and you get a {g:golden medal}"
