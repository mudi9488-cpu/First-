  },
  {
   "id": "outside",
   "label": "",
   "lines": [
    {
     "show": "All over town,"
    },
    {
     "show": "people stepped out of their houses."
    },
    {
     "show": "One by one."
    },
    {
     "show": "Red lights {r:everywhere.}"
