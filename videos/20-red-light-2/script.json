    {
     "show": "It was the {r:biggest,}"
    },
    {
     "show": "{r:reddest} light"
    },
    {
     "show": "this town has ever seen."
    },
    {
     "show": "You could see it from {y:space.}"
    }
   ]
  },
  {
   "id": "end",
   "label": "",
   "lines": [
    {
     "show": "The next day,"
    },
    {
     "show": "we turned the machine off forever."
    },
    {
     "show": "My mom hugged me so hard"
    },
    {
     "show": "my light {y:flickered.}"
    },
    {
     "show": "And me?"
    },
    {
     "show": "My light stayed on"
