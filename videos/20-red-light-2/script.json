   ]
  },
  {
   "id": "switch",
   "label": "",
   "lines": [
    {
     "show": "Then I walked back to the machine"
    },
    {
     "show": "and flipped one more switch."
    }
   ]
  },
  {
   "id": "mayorlight",
   "label": "",
   "lines": [
    {
     "show": "The mayor's light turned on."
