{
 "title": "Height = Money",
 "voice": "ElevenLabs: In This town",
 "beats": [
  {
   "id": "hook",
   "label": "",
   "lines": [
    {
     "show": "In this town, your height shows"
    },
    {
     "show": "how much {y:money} you have."
    },
    {
     "show": "Every dollar in your bank account"
    },
    {
     "show": "makes you {y:taller.}"
    }
   ]
  },
  {
   "id": "ex",
   "label": "",
   "lines": [
    {
     "show": "Got {r:ten dollars?}"
    },
    {
     "show": "You're as tall as a cat."
    },
    {
     "show": "A {y:thousand} dollars?"
    },
    {
     "show": "Normal size."
    },
    {
     "show": "A {g:million} dollars?"
    },
    {
     "show": "You're taller than a house."
    }
   ]
  },
  {
   "id": "gold",
   "label": "",
   "lines": [
    {
     "show": "The richest man in town, {y:Mr. Gold,}"
    },
    {
     "show": "is so tall"
    },
    {
     "show": "that birds build nests in his hair."
    }
   ]
  },
  {
   "id": "age",
   "label": "",
   "lines": [
    {
     "show": "Babies are born the size of a {y:peanut.}"
    },
    {
     "show": "And grandparents who saved money"
    },
