    },
    {
     "show": "{y:Literally.}"
    },
    {
     "show": "When you buy something,"
    },
    {
     "show": "you {r:shrink} right in the middle of the store."
    },
    {
     "show": "And when someone wins the lottery,"
    },
    {
     "show": "they shoot up so fast"
    },
    {
     "show": "they {r:crash} through the roof."
    },
    {
     "show": "Banks don't even need cards here."
    },
    {
     "show": "They just {y:measure} you."
    }
   ]
  },
  {
   "id": "rule2",
   "label": "",
   "lines": [
    {
     "show": "So everybody wants to be {y:tall.}"
    },
    {
