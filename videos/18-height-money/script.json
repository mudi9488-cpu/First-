  },
  {
   "id": "life",
   "label": "",
   "lines": [
    {
     "show": "The stairs at school are like {r:mountains.}"
    },
    {
     "show": "My classmates almost step on me"
    },
    {
     "show": "every single day."
    },
    {
     "show": "And my lunch is one single {y:crumb.}"
    },
    {
     "show": "It lasts {y:three days.}"
    }
   ]
  },
  {
   "id": "try",
   "label": "",
   "lines": [
    {
     "show": "I tried everything to get taller."
    },
    {
     "show": "I sold lemonade."
    },
    {
     "show": "{r:Twenty cents.}"
    },
    {
     "show": "I grew one millimeter."
    },
    {
     "show": "I found a coin on the street,"
    },
    {
     "show": "and a {r:pigeon} almost carried me away."
    }
   ]
  },
  {
   "id": "games",
   "label": "",
   "lines": [
