    {
     "show": "Small means {r:poor.}"
    }
   ]
  },
  {
   "id": "me",
   "label": "",
   "lines": [
    {
     "show": "My name is {y:Sam.}"
    },
    {
     "show": "I'm fifteen,"
    },
    {
     "show": "and I'm exactly {r:four inches} tall."
    },
    {
     "show": "Because my family has"
