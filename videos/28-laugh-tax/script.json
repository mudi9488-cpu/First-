    {
     "show": "Everyone heard the mayor laughing."
    },
    {
     "show": "And that was so funny,"
    },
    {
     "show": "that everybody laughed."
    },
    {
     "show": "All at once."
    },
    {
     "show": "And every HA-meter"
    },
    {
     "show": "in town {r:exploded.}"
    }
   ]
  },
  {
   "id": "after",
   "label": "",
   "lines": [
    {
     "show": "Now laughing is free."
    },
    {
     "show": "Kevin laughs at everything."
    },
    {
     "show": "Linda laughs at her own jokes again."
    },
    {
     "show": "And my grandma"
    },
    {
     "show": "laughed for the first time in thirty years."
    },
    {
     "show": "Her teeth flew out."
    }
   ]
  },
  {
   "id": "end",
   "label": "",
   "lines": [
    {
     "show": "And the mayor?"
    },
    {
     "show": "He owes the town"
    },
    {
     "show": "so much money,"
    },
    {
     "show": "he works for Kevin now."
    },
    {
     "show": "Walking his {y:cat.}"
    }
   ]
  }
 ]
