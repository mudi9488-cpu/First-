{
 "title": "The Mirror Rule",
 "voice": "ElevenLabs In This town (eleven_v4, 1 take)",
 "beats": [
  {
   "id": "hook",
   "label": "",
   "lines": [
    {
     "show": "In this town,"
    },
    {
     "show": "every mirror has to be covered"
    },
    {
     "show": "at {r:midnight.}"
    },
    {
     "show": "Every single one."
    },
    {
     "show": "Bathrooms."
    },
    {
     "show": "Hallways."
    },
    {
     "show": "Even car mirrors."
    },
    {
     "show": "Because after midnight,"
    },
    {
     "show": "your reflection"
    },
    {
     "show": "stops {r:copying you.}"
    },
    {
     "show": "It moves on its own."
    },
    {
     "show": "It smiles when you're sad."
    },
    {
     "show": "And if you stare at it for too long,"
    },
    {
     "show": "it remembers your face."
    }
   ]
  },
  {
   "id": "hale",
   "label": "",
   "lines": [
    {
     "show": "But Mrs. Hale from next door"
